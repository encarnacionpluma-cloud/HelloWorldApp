@{
    ViewData["Title"] = "Hello World";
}

<style>
    .happy-2026 {
        font-size: 6rem;
        font-weight: 800;
        line-height: 1;
        background: linear-gradient(90deg, #ff416c, #ff4b2b, #fbc531, #4ade80, #60a5fa);
        background-size: 200% 200%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: gradientShift 4s ease infinite, pulse 2.5s ease-in-out infinite;
        text-shadow: 0 8px 24px rgba(0,0,0,0.25);
        display: inline-block;
        margin-bottom: 0.5rem;
    }

    @@keyframes gradientShift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    @@keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.05); }
    }

    .confetti {
        margin-left: 0.6rem;
        font-size: 2.6rem;
        display: inline-block;
        vertical-align: middle;
        animation: confettiDrop 1.4s ease-in-out infinite;
    }

    @@keyframes confettiDrop {
        0% { transform: translateY(-6px) rotate(-10deg); }
        50% { transform: translateY(6px) rotate(10deg); }
        100% { transform: translateY(-6px) rotate(-10deg); }
    }
</style>

<div class="text-center">
    <h1 class="happy-2026">Happy 2026! <span class="confetti">🎉✨</span></h1>
    <h1 class="display-4">@ViewData["Message"]</h1>
    <p class="lead">@ViewData["Subtitle"]</p>
    <hr />
   
    <p>This is a simple MVC application demonstrating the Model-View-Controller pattern.</p>
    <p>
        <strong>Controller:</strong> HomeController.cs handles the request<br />
        <strong>View:</strong> Index.cshtml displays the content<br />
        <strong>Model:</strong> Data passed from controller to view
    </p>
</div>
